# Copy to .env and fill in. NEVER commit the real .env file.
# PatchPilot reads these through backend/config.py.

# Required for real model inference (Google AI Studio, free tier works):
GEMINI_API_KEY=

# Optional model override (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Server
HOST=127.0.0.1
PORT=8000

# Persistence (defaults to backend/patchpilot.db)
DATABASE_URL=sqlite:///./backend/patchpilot.db

# Limits
AGENT_TIMEOUT_SECONDS=60
MAX_UPLOAD_MB=10
MAX_SOURCE_CODE_CHARS=200000

# Frontend build-time override (set in frontend environment, not here)
# VITE_API_BASE=http://127.0.0.1:8000
